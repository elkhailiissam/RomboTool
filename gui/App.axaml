<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RomboTool.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="BgBrush" Color="#0E1014" />
        <SolidColorBrush x:Key="CardBrush" Color="#181B22" />
        <SolidColorBrush x:Key="CardHiBrush" Color="#20242D" />
        <SolidColorBrush x:Key="TileBrush" Color="#161A21" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2F3A" />
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#22262F" />
        <SolidColorBrush x:Key="TextBrush" Color="#E7E9ED" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8A92A0" />
        <SolidColorBrush x:Key="FaintBrush" Color="#5B626E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="GreenBrush" Color="#22C55E" />

        <!-- Elevated surface: subtle top-lit gradient -->
        <LinearGradientBrush x:Key="CardGradient" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#1C2029" Offset="0" />
            <GradientStop Color="#171A21" Offset="1" />
        </LinearGradientBrush>

        <!-- Primary action gradient -->
        <LinearGradientBrush x:Key="GreenGradient" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#2EDC74" Offset="0" />
            <GradientStop Color="#1DAE5A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#3B82F6" Offset="0" />
            <GradientStop Color="#22C55E" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#3B82F6" Offset="0" />
            <GradientStop Color="#38BDF8" Offset="0.5" />
            <GradientStop Color="#22C55E" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LogoGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#3B82F6" Offset="0" />
            <GradientStop Color="#22C55E" Offset="1" />
        </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- ───────────────── Typography ───────────────── -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.stat">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.statlabel">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
            <Setter Property="LetterSpacing" Value="0.8" />
        </Style>

        <!-- ───────────────── Cards & surfaces ───────────────── -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardGradient}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 10 28 -6 #66000000, 0 2 6 -2 #40000000" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{StaticResource TileBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="Border.inset">
            <Setter Property="Background" Value="#101318" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BoxShadow" Value="inset 0 1 3 0 #40000000" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{StaticResource CardHiBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ───────────────── Buttons ───────────────── -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource CardHiBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2B313D" />
            <Setter Property="BorderBrush" Value="#39414F" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#20252F" />
        </Style>

        <Style Selector="Button.go">
            <Setter Property="Background" Value="{StaticResource GreenGradient}" />
            <Setter Property="Foreground" Value="#05230F" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.go /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Button.go:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#34E27C" />
        </Style>
        <Style Selector="Button.go:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#243528" />
            <Setter Property="Foreground" Value="#5A6B60" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#5A9BFF" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="#F87171" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A2226" />
            <Setter Property="BorderBrush" Value="#5B2E33" />
        </Style>

        <!-- ───────────────── Inputs ───────────────── -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#101318" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#39414F" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#C7CDD6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="#101318" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>

        <!-- ───────────────── Progress ───────────────── -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource ProgressGradient}" />
            <Setter Property="Background" Value="#0C0F14" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="MinHeight" Value="9" />
        </Style>

        <!-- ───────────────── Tabs ───────────────── -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <!-- ───────────────── DataGrid ───────────────── -->
        <Style Selector="DataGrid">
            <Setter Property="RowHeight" Value="30" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Background" Value="#0C0F14" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="SeparatorBrush" Value="{StaticResource BorderSoftBrush}" />
        </Style>
        <Style Selector="DataGridRow:nth-child(2n)">
            <Setter Property="Background" Value="#12151B" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </Application.Styles>
</Application>
