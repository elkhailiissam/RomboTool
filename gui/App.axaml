<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RomboTool.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ───────── Dark ───────── -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Bg" Color="#0D0F13" />
                    <SolidColorBrush x:Key="Surface" Color="#171A21" />
                    <SolidColorBrush x:Key="SurfaceAlt" Color="#12151B" />
                    <SolidColorBrush x:Key="Elevated" Color="#21252E" />
                    <SolidColorBrush x:Key="Border" Color="#262B36" />
                    <SolidColorBrush x:Key="Line" Color="#1E222B" />
                    <SolidColorBrush x:Key="Text" Color="#E8EAEE" />
                    <SolidColorBrush x:Key="TextMuted" Color="#98A0AD" />
                    <SolidColorBrush x:Key="TextFaint" Color="#5C6370" />
                    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#1B2740" />
                    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Success" Color="#22C55E" />
                    <SolidColorBrush x:Key="Warning" Color="#F5A524" />
                    <SolidColorBrush x:Key="Error" Color="#F87171" />
                    <SolidColorBrush x:Key="Info" Color="#38BDF8" />
                    <SolidColorBrush x:Key="Selection" Color="#20304F" />
                    <SolidColorBrush x:Key="Hover" Color="#1C212A" />
                    <SolidColorBrush x:Key="Field" Color="#0F1217" />
                </ResourceDictionary>

                <!-- ───────── Light ───────── -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Bg" Color="#F3F4F7" />
                    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceAlt" Color="#EEF0F4" />
                    <SolidColorBrush x:Key="Elevated" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Border" Color="#E1E4EA" />
                    <SolidColorBrush x:Key="Line" Color="#E7E9EE" />
                    <SolidColorBrush x:Key="Text" Color="#171A20" />
                    <SolidColorBrush x:Key="TextMuted" Color="#5B626D" />
                    <SolidColorBrush x:Key="TextFaint" Color="#9AA0AA" />
                    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#DCE7FF" />
                    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Success" Color="#15A34A" />
                    <SolidColorBrush x:Key="Warning" Color="#C2740B" />
                    <SolidColorBrush x:Key="Error" Color="#DC2626" />
                    <SolidColorBrush x:Key="Info" Color="#0284C7" />
                    <SolidColorBrush x:Key="Selection" Color="#D9E6FF" />
                    <SolidColorBrush x:Key="Hover" Color="#EDF0F5" />
                    <SolidColorBrush x:Key="Field" Color="#F6F7F9" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ───────── Lucide-style icon geometries (24×24 viewBox) ───────── -->
            <StreamGeometry x:Key="IconSearch">M19,11 A8,8 0 1 1 3,11 A8,8 0 1 1 19,11 M21,21 L16.65,16.65</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M22,19 A2,2 0 0 1 20,21 H4 A2,2 0 0 1 2,19 V5 A2,2 0 0 1 4,3 H9 L11,6 H20 A2,2 0 0 1 22,8 Z</StreamGeometry>
            <StreamGeometry x:Key="IconFolderPlus">M22,19 A2,2 0 0 1 20,21 H4 A2,2 0 0 1 2,19 V5 A2,2 0 0 1 4,3 H9 L11,6 H20 A2,2 0 0 1 22,8 Z M12,10 V16 M9,13 H15</StreamGeometry>
            <StreamGeometry x:Key="IconFile">M14,2 H6 A2,2 0 0 0 4,4 V20 A2,2 0 0 0 6,22 H18 A2,2 0 0 0 20,20 V8 Z M14,2 V8 H20</StreamGeometry>
            <StreamGeometry x:Key="IconFilePlus">M14,2 H6 A2,2 0 0 0 4,4 V20 A2,2 0 0 0 6,22 H18 A2,2 0 0 0 20,20 V8 Z M14,2 V8 H20 M12,12 V18 M9,15 H15</StreamGeometry>
            <StreamGeometry x:Key="IconX">M18,6 L6,18 M6,6 L18,18</StreamGeometry>
            <StreamGeometry x:Key="IconChevron">M6,9 L12,15 L18,9</StreamGeometry>
            <StreamGeometry x:Key="IconClock">M22,12 A10,10 0 1 1 2,12 A10,10 0 1 1 22,12 M12,6 V12 L16,14</StreamGeometry>
            <StreamGeometry x:Key="IconSun">M17,12 A5,5 0 1 1 7,12 A5,5 0 1 1 17,12 M12,1 V3 M12,21 V23 M4.2,4.2 L5.6,5.6 M18.4,18.4 L19.8,19.8 M1,12 H3 M21,12 H23 M4.2,19.8 L5.6,18.4 M18.4,5.6 L19.8,4.2</StreamGeometry>
            <StreamGeometry x:Key="IconMoon">M21,12.8 A9,9 0 1 1 11.2,3 A7,7 0 0 0 21,12.8 Z</StreamGeometry>
            <StreamGeometry x:Key="IconHelp">M22,12 A10,10 0 1 1 2,12 A10,10 0 1 1 22,12 M9.1,9 A3,3 0 1 1 12.5,12.9 C11.5,13.4 11,14 11,15 M12,18 L12,18.01</StreamGeometry>
            <StreamGeometry x:Key="IconCopy">M20,9 H11 A2,2 0 0 0 9,11 V20 A2,2 0 0 0 11,22 H20 A2,2 0 0 0 22,20 V11 A2,2 0 0 0 20,9 Z M5,15 H4 A2,2 0 0 1 2,13 V4 A2,2 0 0 1 4,2 H13 A2,2 0 0 1 15,4 V5</StreamGeometry>
            <StreamGeometry x:Key="IconExport">M12,3 V15 M7,10 L12,15 L17,10 M5,20 H19</StreamGeometry>
            <StreamGeometry x:Key="IconTrash">M3,6 H21 M8,6 V4 A1,1 0 0 1 9,3 H15 A1,1 0 0 1 16,4 V6 M19,6 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V6 M10,11 V17 M14,11 V17</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M20,6 L9,17 L4,12</StreamGeometry>
            <StreamGeometry x:Key="IconCheckSquare">M9,11 L12,14 L22,4 M21,12 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H16</StreamGeometry>
            <StreamGeometry x:Key="IconArrowRight">M5,12 H19 M13,6 L19,12 L13,18</StreamGeometry>
            <StreamGeometry x:Key="IconSliders">M4,7 H14 M18,7 H20 M4,17 H10 M14,17 H20 M14,4 V10 M10,14 V20</StreamGeometry>
            <!-- Filled -->
            <StreamGeometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</StreamGeometry>
            <StreamGeometry x:Key="IconPause">M6,4 H10 V20 H6 Z M14,4 H18 V20 H14 Z</StreamGeometry>
            <StreamGeometry x:Key="IconStop">M6,6 H18 V18 H6 Z</StreamGeometry>
            <StreamGeometry x:Key="IconZap">M13,2 L4,14 H11 L10,22 L20,10 H13 Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- ───────────────── Typography ───────────────── -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="LetterSpacing" Value="1.1" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.stat">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style Selector="TextBlock.statlabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="LetterSpacing" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Code,Menlo,Consolas,monospace" />
        </Style>

        <!-- ───────────────── Surfaces (flat, thin borders — no shadows) ───────────────── -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="Border.inset">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ───────────────── Buttons ─────────────────
             Fluent's button template paints its ContentPresenter from internal theme
             resources, so we set the visible background on the ContentPresenter itself
             (per state) to keep colours deterministic across light/dark. -->
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Elevated}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.13" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selection}" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Primary (accent) -->
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#5A9BFF" />
        </Style>

        <!-- Go (success) -->
        <Style Selector="Button.go">
            <Setter Property="Foreground" Value="#052611" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.go /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Success}" />
        </Style>
        <Style Selector="Button.go:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#34E27C" />
        </Style>

        <!-- Ghost / toolbar -->
        <Style Selector="Button.ghost">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
        </Style>

        <!-- Icon button (square) -->
        <Style Selector="Button.icon">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.icon /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{DynamicResource Error}" />
        </Style>

        <!-- Tiny chip close button -->
        <Style Selector="Button.chipx">
            <Setter Property="Padding" Value="3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.chipx /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.chipx:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
        </Style>

        <!-- ───────────────── Inputs ───────────────── -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Spotlight search field wrapper -->
        <Style Selector="Border.searchfield">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style Selector="Border.searchfield:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="TextBox.plain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.plain:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- Expander (Advanced) -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ───────────────── Progress ───────────────── -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="6" />
        </Style>

        <!-- ───────────────── Icons ───────────────── -->
        <Style Selector="Path.ico">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Path.ico-fill">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
        </Style>

        <!-- ───────────────── Pill tabs ───────────────── -->
        <Style Selector="TabControl WrapPanel">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>
        <!-- kill the default underline strip -->
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- ───────────────── DataGrid ───────────────── -->
        <Style Selector="DataGrid">
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource Line}" />
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="DataGridRow:nth-child(2n)">
            <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource Hover}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource Selection}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Context menu -->
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
    </Application.Styles>
</Application>
