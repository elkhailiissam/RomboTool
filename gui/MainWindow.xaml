<Window x:Class="RomboTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RomboTool" Height="700" Width="1000" Background="#1E1E1E"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDrag">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="⚡ RomboTool" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text=" v1.0" FontSize="14" Foreground="#666" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
        </StackPanel>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Background="#252526" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Input Files" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="Drag &amp; drop or browse" Foreground="#888" Margin="0,4,0,10"/>
                        <Grid>
                            <TextBox x:Name="InputBox" Style="{StaticResource Txt}" IsReadOnly="True" Text="No files..."/>
                            <Button Content="Browse" Style="{StaticResource BtnSec}" HorizontalAlignment="Right" Click="Browse"/>
                        </Grid>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="6" Margin="0,15" Padding="10">
                        <TextBox x:Name="Preview" Background="Transparent" Foreground="#AADDAA" FontFamily="Consolas"
                                 IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Text="Preview..."/>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Files" Foreground="#888"/>
                            <TextBlock x:Name="FileCount" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Lines" Foreground="#888"/>
                            <TextBlock x:Name="LineCount" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            
            <Border Grid.Column="2" Background="#252526" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="16" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <CheckBox x:Name="Dedup" IsChecked="True" Foreground="White" Margin="0,0,0,8">Remove Duplicates</CheckBox>
                        <CheckBox x:Name="EmailOnly" Foreground="White" Margin="0,0,0,8">Emails Only</CheckBox>
                        <CheckBox x:Name="UserOnly" Foreground="White" Margin="0,0,0,15">Usernames Only</CheckBox>
                        <TextBlock Text="Output" Foreground="#888" Margin="0,0,0,5"/>
                        <TextBox x:Name="OutBox" Style="{StaticResource Txt}" Text="filtered.txt"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="6" Margin="0,15" Padding="10">
                        <TextBox x:Name="Output" Background="Transparent" Foreground="#AAAADD" FontFamily="Consolas"
                                 IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Text="Output preview..."/>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Valid" Foreground="#888"/><TextBlock x:Name="Valid" Text="0" Foreground="#28A745" FontSize="18" FontWeight="Bold"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Emails" Foreground="#888"/><TextBlock x:Name="Emails" Text="0" Foreground="#007ACC" FontSize="18" FontWeight="Bold"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Users" Foreground="#888"/><TextBlock x:Name="Users" Text="0" Foreground="#FFA500" FontSize="18" FontWeight="Bold"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="Phones" Foreground="#888"/><TextBlock x:Name="Phones" Text="0" Foreground="#9B59B6" FontSize="18" FontWeight="Bold"/></StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal">
                <ProgressBar x:Name="Progress" Width="300" Height="6" Background="#3D3D3D" Foreground="#007ACC" Visibility="Collapsed"/>
                <TextBlock x:Name="Status" Text="Ready" Foreground="#888" VerticalAlignment="Center" Margin="15,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear" Style="{StaticResource BtnSec}" Click="Clear" Margin="0,0,10,0"/>
                <Button x:Name="GoBtn" Content="🚀 Start" Style="{StaticResource BtnGo}" MinWidth="150" Click="Start"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
