<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RomboTool.MainWindow"
        Icon="/Assets/icon.png"
        Title="RomboTool" Width="1180" Height="780"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- App bar -->
        <Border DockPanel.Dock="Top" Padding="18,13" BorderThickness="0,0,0,1"
                BorderBrush="#20242D">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#1A1D24" Offset="0" />
                    <GradientStop Color="#121419" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Logo badge -->
                    <Border Width="40" Height="40" CornerRadius="11"
                            Background="{StaticResource LogoGradient}"
                            BoxShadow="0 4 14 -2 #663B82F6">
                        <TextBlock Text="⚡" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="RomboTool" Classes="h1" />
                        <TextBlock Text="fast search · large-file ready" FontSize="11.5"
                                   Foreground="{StaticResource FaintBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Classes="chip" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="v3.0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                </Border>
            </Grid>
        </Border>
        <!-- Accent underline -->
        <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource AccentGradient}" Opacity="0.85" />

        <TabControl Margin="12,8,12,12" Padding="0">

            <!-- ============================= GREP SEARCH ============================= -->
            <TabItem Header="🔍  Search">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,10,0,0">

                    <!-- ── Query card ── -->
                    <Border Grid.Row="0" Classes="card" Padding="16" Margin="0,0,0,10">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                            <!-- Source -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Text="Search in" Classes="label" Width="70" />
                                <TextBox Grid.Column="1" x:Name="PathBox"
                                         Watermark="Pick a file or folder…" TextChanged="OnPathChanged" />
                                <Button Grid.Column="2" Content="📄 File" Click="OnBrowseFile" Margin="8,0,0,0" />
                                <Button Grid.Column="3" Content="📁 Folder" Click="OnBrowseFolder" Margin="6,0,0,0" />
                                <Border Grid.Column="4" Classes="chip" x:Name="TypeChip" Margin="8,0,0,0" IsVisible="False">
                                    <TextBlock x:Name="TypeChipText" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                </Border>
                            </Grid>

                            <!-- Folder-only filters -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" x:Name="FolderFilters" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Text="Files" Classes="label" Width="70" />
                                <TextBox Grid.Column="1" x:Name="FilesBox" Text="*"
                                         Watermark="*.txt *.log   (space-separated globs)" />
                                <CheckBox Grid.Column="2" x:Name="RecurseChk" Content="Subfolders"
                                          IsChecked="True" Margin="12,0,0,0" />
                            </Grid>

                            <!-- Text + options -->
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Text="Find" Classes="label" Width="70" />
                                <TextBox Grid.Column="1" x:Name="SearchTextBox"
                                         Watermark="text or regex to find…" KeyDown="OnSearchKeyDown" />
                                <CheckBox Grid.Column="2" x:Name="RegexChk" Content="Regex" Margin="12,0,0,0" />
                                <CheckBox Grid.Column="3" x:Name="IgnoreCaseChk" Content="Ignore case"
                                          IsChecked="True" Margin="12,0,0,0" />
                                <CheckBox Grid.Column="4" x:Name="InvertChk" Content="Invert" Margin="12,0,0,0" />
                            </Grid>

                            <!-- Actions -->
                            <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                                <Button Grid.Column="0" x:Name="SearchBtn" Content="Search"
                                        Classes="go" MinWidth="120" Click="OnRunGrep" />
                                <Button Grid.Column="1" x:Name="StopBtn" Content="Stop" Classes="danger"
                                        Margin="8,0,0,0" IsEnabled="False" Click="OnStopGrep" />
                                <CheckBox Grid.Column="2" x:Name="LimitChk" Content="Stop after"
                                          IsChecked="True" Margin="18,0,8,0" />
                                <NumericUpDown Grid.Column="3" x:Name="LimitBox" Value="50000"
                                               Minimum="1" Maximum="100000000" Increment="10000"
                                               Width="150" FormatString="N0" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ── Live progress card ── -->
                    <Border Grid.Row="1" Classes="card" Padding="16,14" Margin="0,0,0,10">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <!-- Stat tiles -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,14">
                                <Border Grid.Column="0" Classes="tile" Margin="0,0,5,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="PROGRESS" Classes="statlabel" />
                                        <TextBlock x:Name="StatPercent" Text="0%" Classes="stat"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="tile" Margin="5,0,5,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="DATA SCANNED" Classes="statlabel" />
                                        <TextBlock x:Name="StatData" Text="—" Classes="stat"
                                                   Foreground="{StaticResource TextBrush}" FontSize="16" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="tile" Margin="5,0,5,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="SPEED" Classes="statlabel" />
                                        <TextBlock x:Name="StatSpeed" Text="—" Classes="stat"
                                                   Foreground="{StaticResource TextBrush}" FontSize="16" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Classes="tile" Margin="5,0,5,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="MATCHES" Classes="statlabel" />
                                        <TextBlock x:Name="StatMatches" Text="0" Classes="stat"
                                                   Foreground="{StaticResource GreenBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Classes="tile" Margin="5,0,0,0">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="ELAPSED" Classes="statlabel" />
                                        <TextBlock x:Name="StatElapsed" Text="0.0s" Classes="stat"
                                                   Foreground="{StaticResource TextBrush}" FontSize="16" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ProgressBar Grid.Row="1" x:Name="GrepProgress" Minimum="0" Maximum="1" Value="0" Margin="0,0,0,12" />

                            <TextBlock Grid.Row="2" x:Name="StatCurrent"
                                       Text="Ready — pick a file or folder, type what to find, and hit Search."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- ── Results ── -->
                    <Border Grid.Row="2" Classes="inset">
                        <DataGrid x:Name="ResultsGrid"
                                  IsReadOnly="True"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single"
                                  DoubleTapped="OnOpenResult"
                                  Background="Transparent"
                                  FontFamily="Cascadia Code,Cascadia Mono,Menlo,Consolas,monospace"
                                  FontSize="12.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="220" />
                                <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="90" />
                                <DataGridTextColumn Header="Text" Binding="{Binding Line}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Grid.Row="3" x:Name="GrepStatus"
                               Text="Double-click a result to open its file."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,8,0,0" />
                </Grid>
            </TabItem>

            <!-- ============================= COMBO FILTER ============================= -->
            <TabItem Header="🧹  Combo Filter">
                <Grid ColumnDefinitions="*,12,*" Margin="0,10,0,0">

                    <!-- Left: input -->
                    <Border Grid.Column="0" Classes="card" Padding="18">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Row="0" Spacing="6">
                                <TextBlock Text="INPUT FILES" Classes="section" />
                                <TextBlock Text="Drag &amp; drop files here, or browse."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" x:Name="InputBox" IsReadOnly="True" Text="No files…" />
                                    <Button Grid.Column="1" Content="Browse" Classes="accent" Margin="6,0,0,0" Click="OnAddFiles" />
                                    <Button Grid.Column="2" Content="Clear" Margin="6,0,0,0" Click="OnClearFiles" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="1" Classes="inset" Margin="0,14" Padding="12">
                                <TextBox x:Name="Preview" Background="Transparent" Foreground="#8FE3A6"
                                         FontFamily="Cascadia Code,Menlo,Consolas,monospace" FontSize="12"
                                         IsReadOnly="True" BorderThickness="0" AcceptsReturn="True"
                                         TextWrapping="NoWrap" Text="Preview…" />
                            </Border>

                            <Grid Grid.Row="2" ColumnDefinitions="*,*">
                                <Border Grid.Column="0" Classes="tile" Margin="0,0,5,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="FILES" Classes="statlabel" />
                                        <TextBlock x:Name="FileCount" Text="0" Classes="stat" FontSize="18"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="tile" Margin="5,0,0,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="TOTAL SIZE" Classes="statlabel" />
                                        <TextBlock x:Name="SizeCount" Text="0 B" Classes="stat" FontSize="18"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right: settings + output -->
                    <Border Grid.Column="2" Classes="card" Padding="18">
                        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                            <StackPanel Grid.Row="0" Spacing="8">
                                <TextBlock Text="SETTINGS" Classes="section" />
                                <CheckBox x:Name="DedupChk" Content="Remove duplicates" IsChecked="True" />
                                <CheckBox x:Name="EmailOnlyChk" Content="Emails only" />
                                <CheckBox x:Name="UserOnlyChk" Content="Usernames only" />
                                <TextBlock Text="OUTPUT" Classes="statlabel" Margin="0,6,0,2" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" x:Name="OutBox" Text="filtered.txt" />
                                    <Button Grid.Column="1" Content="Save As" Margin="6,0,0,0" Click="OnChooseOutput" />
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="1" Classes="inset" Margin="0,14" Padding="12">
                                <TextBox x:Name="Output" Background="Transparent" Foreground="#9FB4FF"
                                         FontFamily="Cascadia Code,Menlo,Consolas,monospace" FontSize="12"
                                         IsReadOnly="True" BorderThickness="0" AcceptsReturn="True"
                                         TextWrapping="NoWrap" Text="Output preview…" />
                            </Border>

                            <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" Margin="0,0,0,12">
                                <Border Grid.Column="0" Classes="tile" Margin="0,0,5,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="VALID" Classes="statlabel" />
                                        <TextBlock x:Name="ValidStat" Text="0" Classes="stat" FontSize="18" Foreground="{StaticResource GreenBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="tile" Margin="5,0,5,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="EMAILS" Classes="statlabel" />
                                        <TextBlock x:Name="EmailStat" Text="0" Classes="stat" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="tile" Margin="5,0,5,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="USERS" Classes="statlabel" />
                                        <TextBlock x:Name="UserStat" Text="0" Classes="stat" FontSize="18" Foreground="#F5A524" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Classes="tile" Margin="5,0,0,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="PHONES" Classes="statlabel" />
                                        <TextBlock x:Name="PhoneStat" Text="0" Classes="stat" FontSize="18" Foreground="#A78BFA" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ProgressBar Grid.Row="3" x:Name="ComboProgress" Minimum="0" Maximum="1" Value="0"
                                         Foreground="{StaticResource GreenBrush}" Margin="0,0,0,10" />

                            <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" x:Name="ComboStatus" Text="Ready"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="12" />
                                <Button Grid.Column="1" x:Name="ComboStopBtn" Content="Stop" Classes="danger"
                                        IsEnabled="False" Margin="0,0,8,0" Click="OnStopCombo" />
                                <Button Grid.Column="2" x:Name="ComboGoBtn" Content="🚀 Start"
                                        Classes="go" MinWidth="130" Click="OnRunCombo" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
